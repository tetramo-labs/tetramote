{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tetramote",
  "version": "0.4.7",
  "identifier": "com.tetramo.tetramote.host",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Tetramote",
        "width": 360,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Control your computers from anywhere over iroh",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": null,
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tetramote"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCODc0NDNFNTU3NENCRDAKUldUUXkzUlZQa1NIbTFjZnF4UXRXMzdqaW15TkFQb1M3cXkrMjVvK3lTYnRGV2VrOXlYMGU2OVEK",
      "endpoints": [
        "https://github.com/tetramo-labs/tetramote/releases/latest/download/latest.json"
      ]
    }
  }
}
